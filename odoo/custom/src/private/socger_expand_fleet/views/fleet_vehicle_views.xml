<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fleet_vehicle_form_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.form.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_form" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <!-- FASE 1: replace location char field with fleet_garage_id (Cochera) -->
            <xpath expr="//field[@name='location']" position="replace">
                <field name="fleet_garage_id" />
            </xpath>

            <!-- Relabel odometer field as "Km actuales" -->
            <xpath expr="//label[@for='odometer']" position="attributes">
                <attribute name="string">Km actuales</attribute>
            </xpath>

            <!-- Show odometer update date below the odometer field -->
            <xpath expr="//div[.//field[@name='odometer']]" position="after">
                <field name="odometer_date" invisible="vehicle_type != 'car'" />
            </xpath>

            <!-- FASE 1: show vehicle code between the license plate and the tags -->
            <xpath expr="//h2[./field[@name='license_plate']]" position="after">
                <label for="vehicle_code" />
                <field
                    name="vehicle_code"
                    class="oe_inline"
                    placeholder="e.g. VHC-001"
                />
            </xpath>

            <!-- FASE 1: add company and partner below odometer_date, before manager_id -->
            <xpath expr="//field[@name='odometer_date']" position="after">
                <field name="res_company_id" />
                <field name="res_partner_id" />
            </xpath>

            <!-- FASE 1: move model_id out of the title and keep it before category_id -->
            <xpath
                expr="//div[contains(@class, 'oe_title')]/label[@for='model_id']"
                position="replace"
            />
            <xpath
                expr="//div[contains(@class, 'oe_title')]/h1[./field[@name='model_id']]"
                position="replace"
            />
            <xpath expr="//field[@name='category_id']" position="before">
                <field name="model_id" />
            </xpath>

            <!-- FASE 1: keep tag_ids below vehicle_code -->
            <xpath expr="//label[@for='tag_ids']" position="replace" />
            <xpath expr="//field[@name='tag_ids']" position="replace" />
            <xpath expr="//field[@name='vehicle_code']" position="after">
                <label for="tag_ids" class="me-3" />
                <field
                    name="tag_ids"
                    widget="many2many_tags"
                    options="{'color_field': 'color', 'no_create_edit': True}"
                />
            </xpath>

            <!-- FASE 1: vehicle_type_id before order_date, then digital tachograph
                 and professional diesel below it -->
            <xpath expr="//field[@name='order_date']" position="before">
                <field name="vehicle_type_id" />
            </xpath>
            <xpath expr="//field[@name='vehicle_type_id']" position="after">
                <field name="digital_tachograph" invisible="vehicle_type != 'car'" />
            </xpath>
            <xpath expr="//field[@name='digital_tachograph']" position="after">
                <field
                    name="professional_diesel_tax_relief_beneficiary"
                    invisible="vehicle_type != 'car'"
                />
            </xpath>

            <!-- FASE 1: mileage at purchase after vin_sn, before the odometer -->
            <xpath expr="//field[@name='vin_sn']" position="after">
                <field name="mileage_at_purchase" invisible="vehicle_type != 'car'" />
            </xpath>

            <!-- FASE 1: vehicle age right after the write-off date -->
            <xpath expr="//field[@name='write_off_date']" position="after">
                <field name="vehicle_age" invisible="vehicle_type != 'car'" />
            </xpath>

            <!-- FASE 1: model page - engine/bodywork details before seats (after color) -->
            <xpath expr="//field[@name='seats']" position="before">
                <field name="engine_Chassis" invisible="vehicle_type != 'car'" />
                <field name="bodywork" invisible="vehicle_type != 'car'" />
                <field name="build_Number" invisible="vehicle_type != 'car'" />
            </xpath>

            <!-- FASE 1: replace seats with the seating capacity fields -->
            <xpath expr="//field[@name='seats']" position="replace">
                <field name="seating_capacity_per_permit" />
                <field name="seating_capacity_per_technical_datasheet" />
                <field name="seating_capacity_bookable_seats" />
            </xpath>

            <!-- FASE 1: split the vehicle features page into two side-by-side groups
                 and add the accounting page before Note -->
            <xpath expr="//page[@name='note']" position="before">
                <page
                    string="Características/equipamiento de vehículos"
                    name="vehicle_features"
                >
                    <group col="2">
                        <group string="Características/equipamiento">
                            <field name="vehicle_feature_by_vehicle_ids">
                                <list>
                                    <field name="vehicle_feature_id" />
                                </list>
                            </field>
                        </group>
                        <group string="Configuraciones especiales">
                            <field name="special_configurations" />
                        </group>
                    </group>
                </page>
                <page
                    string="Conceptos de control de costes, presupuestos ó ventas"
                    name="concepts"
                >
                    <field name="concept_cost_budget_sale_by_vehicle_ids">
                        <list>
                            <field name="concept_cost_budget_sale_by_vehicle_type_id" />
                            <field name="value" />
                        </list>
                    </field>
                </page>
                <page string="Contabilidad" name="accounting">
                    <group>
                        <field name="accounting_national_mileage" />
                        <field name="accounting_international_mileage" />
                        <field name="accounting_accounting_project" />
                    </group>
                </page>
            </xpath>
        </field>
    </record>

    <!-- FASE 1: replace location with fleet_garage_id (Cochera) in kanban card -->
    <record id="view_fleet_vehicle_kanban_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.kanban.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_kanban" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//t[@t-if='record.location.raw_value']" position="replace">
                <t t-if="record.fleet_garage_id.raw_value">
                    <small>
                        <i class="fa fa-map-marker" title="Cochera" />
                        <field name="fleet_garage_id" />
                    </small>
                </t>
            </xpath>

            <!-- FASE 1: show company or partner below the license plate -->
            <xpath expr="//div[./field[@name='model_id']]" position="after">
                <div
                    class="small"
                    t-if="record.res_company_id.raw_value or record.res_partner_id.raw_value"
                >
                    <t t-if="record.res_company_id.raw_value">
                        <i class="fa fa-building" title="Empresa" />
                        <field name="res_company_id" />
                    </t>
                    <t t-if="record.res_partner_id.raw_value">
                        <i class="fa fa-handshake-o" title="Empresa colaboradora" />
                        <field name="res_partner_id" />
                    </t>
                </div>
            </xpath>

            <!-- FASE 1: show vehicle code between tags and driver -->
            <xpath expr="//field[@name='tag_ids']" position="after">
                <t t-if="record.vehicle_code.raw_value">
                    <small>
                        <i class="fa fa-hashtag" title="Código de vehículo" />
                        <field name="vehicle_code" />
                    </small>
                </t>
            </xpath>
        </field>
    </record>

    <!-- FASE 1: add vehicle_code column at the beginning of the list -->
    <record id="view_fleet_vehicle_list_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.list.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_tree" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//list/field[@name='license_plate']" position="before">
                <field name="vehicle_code" />
            </xpath>
        </field>
    </record>

    <!-- FASE 1: show license plate + vehicle code combined in the pivot -->
    <record id="view_fleet_vehicle_pivot_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.pivot.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_pivot" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//pivot/field[@name='license_plate']" position="replace">
                <field name="license_plate_with_code" type="row" />
            </xpath>
        </field>
    </record>

    <!-- FASE 1: show license plate + vehicle code combined in the activity -->
    <record id="view_fleet_vehicle_activity_inherit" model="ir.ui.view">
        <field name="name">fleet.vehicle.activity.inherit</field>
        <field name="model">fleet.vehicle</field>
        <field name="inherit_id" ref="fleet.fleet_vehicle_view_activity" />
        <field name="priority" eval="99" />
        <field name="arch" type="xml">
            <xpath expr="//activity/field[@name='license_plate']" position="attributes">
                <attribute name="name">license_plate_with_code</attribute>
            </xpath>
            <xpath
                expr="//div[@t-name='activity-box']//field[@name='license_plate']"
                position="replace"
            >
                <field
                    name="license_plate_with_code"
                    display="full"
                    class="o_text_block"
                />
            </xpath>
        </field>
    </record>
</odoo>

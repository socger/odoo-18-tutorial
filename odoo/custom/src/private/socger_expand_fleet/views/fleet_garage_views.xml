<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <record id="view_fleet_garage_list" model="ir.ui.view">
        <field name="name">fleet.garage.list</field>
        <field name="model">fleet.garage</field>
        <field name="arch" type="xml">
            <list string="Cocheras">
                <field name="name" />
                <field name="res_company_id" />
                <field name="street" />
                <field name="city" />
                <field name="state_id" />
                <field name="zip" />
                <field name="country_id" />
                <field name="latitude" />
                <field name="longitude" />
                <field name="phone" />
                <field name="email" />
                <field name="contact" />
            </list>
        </field>
    </record>

    <record id="view_fleet_garage_form" model="ir.ui.view">
        <field name="name">fleet.garage.form</field>
        <field name="model">fleet.garage</field>
        <field name="arch" type="xml">
            <form string="Cochera">
                <sheet>
                    <div class="oe_title">
                        <label for="name" />
                        <h1>
                            <field name="name" placeholder="Nombre de la cochera..." />
                        </h1>
                    </div>
                    <group>
                        <group>
                            <field name="res_company_id" />
                            <field name="phone" />
                            <field name="email" />
                        </group>
                        <group>
                            <field name="contact" />
                        </group>
                    </group>
                    <group string="Dirección">
                        <group>
                            <field name="street" />
                            <field name="city" />
                            <field name="state_id" />
                            <field name="zip" />
                            <field name="country_id" />
                        </group>
                        <group>
                            <field name="latitude" />
                            <field name="longitude" />
                        </group>
                    </group>
                </sheet>

                <chatter reload_on_post="True" />
            </form>
        </field>
    </record>

    <record id="action_fleet_garage" model="ir.actions.act_window">
        <field name="name">Cocheras</field>
        <field name="res_model">fleet.garage</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Crea la primera cochera
            </p>
            <p>
                Gestiona las cocheras o aparcamientos donde se guarda la flota
                de vehículos, con sus datos de localización y de contacto.
            </p>
        </field>
    </record>
</odoo>

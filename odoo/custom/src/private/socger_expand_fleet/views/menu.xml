<?xml version="1.0" encoding="utf-8" ?>
<odoo>
    <!-- Submenu under "Configuración" (fleet.fleet_configuration), placed
         before "Modelos" (fleet.fleet_models_configuration, sequence 10).
         Opens the list view of the fleet.garage model. -->
    <menuitem
        id="menu_fleet_garage"
        name="Cocheras"
        parent="fleet.fleet_configuration"
        action="action_fleet_garage"
        sequence="5"
        groups="fleet.fleet_group_manager"
    />

    <menuitem
        id="menu_fleet_vehicle_type"
        name="Tipos de vehículo"
        parent="fleet.fleet_models_configuration"
        action="action_fleet_vehicle_type"
        sequence="0"
        groups="fleet.fleet_group_manager"
    />

    <menuitem
        id="menu_fleet_concept_cost_budget_sale"
        name="Conceptos de control de costes, presupuestos ó ventas"
        parent="fleet.fleet_configuration"
        sequence="15"
        groups="fleet.fleet_group_manager"
    />

    <menuitem
        id="menu_concept_cost_budget_sale_family"
        name="Categorías"
        parent="menu_fleet_concept_cost_budget_sale"
        action="action_concept_cost_budget_sale_family"
        sequence="1"
    />

    <menuitem
        id="menu_concept_cost_budget_sale"
        name="Conceptos"
        parent="menu_fleet_concept_cost_budget_sale"
        action="action_concept_cost_budget_sale"
        sequence="5"
    />

    <menuitem
        id="menu_concept_cost_budget_sale_by_vehicle_type"
        name="Conceptos por tipo de vehículo"
        parent="menu_fleet_concept_cost_budget_sale"
        action="action_concept_cost_budget_sale_by_vehicle_type"
        sequence="10"
    />

    <menuitem
        id="menu_fleet_vehicle_features_configuration"
        name="Características/Equipamiento de vehículos"
        parent="fleet.fleet_configuration"
        sequence="15"
        groups="fleet.fleet_group_manager"
    />

    <menuitem
        id="menu_vehicle_feature_category"
        name="Categorías"
        parent="menu_fleet_vehicle_features_configuration"
        action="action_vehicle_feature_category"
        sequence="1"
    />

    <menuitem
        id="menu_vehicle_feature"
        name="Características"
        parent="menu_fleet_vehicle_features_configuration"
        action="action_vehicle_feature"
        sequence="5"
    />

    <menuitem
        id="menu_vehicle_feature_by_vehicle"
        name="Flota - Características por vehículo"
        parent="fleet.fleet_vehicles"
        action="action_vehicle_feature_by_vehicle"
        sequence="1"
        groups="fleet.fleet_group_user"
    />

    <menuitem
        id="menu_concept_cost_budget_sale_by_vehicle"
        name="Flota - Conceptos de control de costes, presupuestos ó ventas"
        parent="fleet.fleet_vehicles"
        action="action_concept_cost_budget_sale_by_vehicle"
        sequence="2"
        groups="fleet.fleet_group_user"
    />

    <menuitem
        id="menu_fleet_vehicle_document"
        name="Flota - Documentación"
        parent="fleet.fleet_vehicles"
        action="action_fleet_vehicle_document"
        sequence="3"
        groups="fleet.fleet_group_user"
    />

    <menuitem
        id="menu_fleet_vehicle_document_configuration"
        name="Flota - Documentación"
        parent="fleet.fleet_configuration"
        sequence="20"
        groups="fleet.fleet_group_manager"
    />

    <menuitem
        id="menu_fleet_vehicle_document_category"
        name="Categorías"
        parent="menu_fleet_vehicle_document_configuration"
        action="action_fleet_vehicle_document_category"
        sequence="10"
    />

    <!-- Reorder "Flota" submenus:
        1. "Flota" (vehicles list, renamed from "Fleet")
        2. "Flota - Características por vehículo"
        3. "Flota - Conceptos de control de costes, presupuestos ó ventas"
        4. "Flota - Documentación"
        5. separator
        6. "Flota - Km actuales por vehículo" (Odometers)
        7. Contracts
        8. Services -->
    <record id="fleet.fleet_vehicle_menu" model="ir.ui.menu">
        <field name="name">Flota</field>
    </record>

    <menuitem
        id="menu_fleet_vehicles_separator"
        name="──────────"
        parent="fleet.fleet_vehicles"
        sequence="4"
        groups="fleet.fleet_group_user"
    />

    <record id="fleet.fleet_vehicle_log_contract_menu" model="ir.ui.menu">
        <field name="sequence">6</field>
    </record>

    <record id="fleet.fleet_vehicle_log_services_menu" model="ir.ui.menu">
        <field name="sequence">7</field>
    </record>

    <record id="fleet.fleet_vehicle_odometer_menu" model="ir.ui.menu">
        <field name="name">Flota - Km actuales por vehículo</field>
        <field name="sequence">5</field>
    </record>
</odoo>
